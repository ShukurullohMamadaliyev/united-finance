# Telegram bot tokeni (@BotFather beradi). Hech kimga koʻrsatmang, saytga yuklamang.
TELEGRAM_BOT_TOKEN=

# Lidlar yuboriladigan guruh ID si. `npm run guruh` oʻzi yozadi.
TELEGRAM_CHAT_ID=

# Server porti
PORT=5180

# Kompyuterda: 127.0.0.1 (faqat shu kompyuter). Hostingda: 0.0.0.0
HOST=127.0.0.1

# Faqat nginx / hosting proksisi ortida ishlaganda 1 qiling
TRUST_PROXY=0
