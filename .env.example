# Telegram bot tokeni (@BotFather beradi). Hech kimga koʻrsatmang, GitHub'ga yuklamang.
# Vercel'da: Project → Settings → Environment Variables → TELEGRAM_BOT_TOKEN
TELEGRAM_BOT_TOKEN=

# DeepSeek AI API kaliti (buxgalteriya AI chati uchun)
# Vercel'da: Project → Settings → Environment Variables → DEEPSEEK_API_KEY
DEEPSEEK_API_KEY=
